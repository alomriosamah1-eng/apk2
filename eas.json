{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        // AAB: Google Play serves per-ABI split APKs to each device, so the
        // installed size stays well under 30MB while remaining compatible with
        // every Android version/ABI (minSdk 24). Use "preview" for a universal
        // APK you can sideload directly.
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}