{
  "expo": {
    "name": "Khaznati",
    "slug": "khaznati",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "khaznati",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.khaznati.vault",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "NSFaceIDUsageDescription": "Khaznati uses Face ID to protect your vault.",
        "NSPhotoLibraryAddUsageDescription": "Khaznati needs access to save exported photos to your library.",
        "NSPhotoLibraryUsageDescription": "Khaznati needs access to your photo library to import photos into your vault."
      }
    },
    "android": {
      "package": "com.khaznati.vault",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "jsEngine": "hermes"
    },
    "updates": {
      "enabled": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-media-library",
        {
          "photosPermission": "Khaznati needs access to your photo library to import photos into your vault.",
          "savePhotosPermission": "Khaznati needs access to save exported photos to your library.",
          "granularPermissions": [
            "photo",
            "video",
            "audio"
          ]
        }
      ],
      "expo-audio",
      "./plugins/withAbiSplits",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 24,
            "hermesEnabled": true
          }
        }
      ]
    ]
  }
}
